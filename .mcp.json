{
  "mcpServers": {
    "ahrefs": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://api.ahrefs.com/mcp/mcp",
        "--header",
        "Authorization:${AHREFS_AUTH_HEADER}"
      ],
      "env": {
        "AHREFS_AUTH_HEADER": "Bearer ${AHREFS_MCP_KEY:-}"
      },
      "alwaysLoad": true,
      "timeout": 600000
    },
    "quick-audit-tools": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "-m",
        "quick_audit_mcp.server"
      ],
      "env": {
        "GOOGLE_SERVICE_ACCOUNT_JSON": "${GOOGLE_SERVICE_ACCOUNT_JSON:-}",
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS:-}",
        "GOOGLE_OAUTH_TOKEN_FILE": "${GOOGLE_OAUTH_TOKEN_FILE:-}",
        "GOOGLE_SHEETS_SPREADSHEET_ID": "${GOOGLE_SHEETS_SPREADSHEET_ID:-}",
        "GOOGLE_PLACES_API_KEY": "${GOOGLE_PLACES_API_KEY:-}",
        "PAGESPEED_API_KEY": "${PAGESPEED_API_KEY:-}",
        "ENABLE_GMAIL_SEND": "false",
        "QUICK_AUDIT_ALLOWED_SEND_DOMAINS": "${QUICK_AUDIT_ALLOWED_SEND_DOMAINS:-}",
        "QUICK_AUDIT_MAX_SEND_RECIPIENTS": "5"
      }
    }
  }
}
