# Ahrefs API key for MCP server authentiation
AHREFS_MCP_KEY=

# Only set true after manual QA and sender safeguards are implemented.
ENABLE_GMAIL_SEND=false

# Runtime / agent
ANTHROPIC_API_KEY=

# Google OAuth client created in Google Cloud Console.
# Use an OAuth Desktop App client for local development.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=./secrets/google-oauth-client.json
GOOGLE_OAUTH_TOKEN_FILE=./secrets/google-oauth-token.json

# Quick Audit Tracker spreadsheet. Use the exact spreadsheet ID only.
GOOGLE_SHEETS_SPREADSHEET_ID=
QUICK_AUDIT_TRACKER_APPEND_RANGE=Audits!A:Z

# Places and PageSpeed
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=

# Gmail auto-send is intentionally disabled by default.
# Keep false until QA, legal/compliance, and recipient/domain allowlists are approved.
ENABLE_GMAIL_SEND=false
QUICK_AUDIT_ALLOWED_SEND_DOMAINS=blitzmetrics.com
QUICK_AUDIT_MAX_SEND_RECIPIENTS=5

# Optional shared Drive/folder IDs for saving rendered reports through Drive MCP or direct API code.
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_AUDIT_FOLDER_ID=
GOOGLE_DRIVE_SHARED_FOLDER_ID=
