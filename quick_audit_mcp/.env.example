# Quick Audit MCP — local environment template. Copy to .env and fill in.
# In the Claude Routine, set these as routine ENV variables instead (never commit real values).

# ── Ahrefs hosted MCP ────────────────────────────────────────────────
AHREFS_MCP_KEY=

# ── Google auth (choose ONE; service account is preferred for the cloud routine) ──
# Option A (recommended, headless): service account — inline JSON OR a key-file path.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
# Only needed to send Gmail AS a user via domain-wide delegation:
GOOGLE_IMPERSONATE_SUBJECT=
# Option B (local dev): a pre-authorized user token file (refreshable).
GOOGLE_OAUTH_TOKEN_FILE=./secrets/google-oauth-token.json
# Option C (local dev only): interactive browser OAuth. NEVER set true in the cloud.
QUICK_AUDIT_ALLOW_INTERACTIVE_OAUTH=false
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=./secrets/google-oauth-client.json

# ── Quick Audit Tracker (Google Sheets) ──────────────────────────────
GOOGLE_SHEETS_SPREADSHEET_ID=
QUICK_AUDIT_TRACKER_APPEND_RANGE=Audits!A:Z

# ── Places & PageSpeed (API keys) ────────────────────────────────────
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=

# ── Gmail auto-send safety (keep disabled until QA + safeguards approved) ──
ENABLE_GMAIL_SEND=false
QUICK_AUDIT_ALLOWED_SEND_DOMAINS=blitzmetrics.com
QUICK_AUDIT_MAX_SEND_RECIPIENTS=5

# ── Optional Drive folder IDs (artifact persistence via the Drive connector) ──
GOOGLE_DRIVE_AUDIT_FOLDER_ID=
GOOGLE_DRIVE_SHARED_DRIVE_ID=

# NOTE: ANTHROPIC_API_KEY is the Routine runtime credential, not an MCP-server variable.
# Configure it at the routine/agent level, not here.
